{
  "name": "novan-design-system",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "prefix": "app",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "browser": "src/main.ts",
        "tsConfig": "tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": ["src/styles.scss"],
        "outputPath": "dist/novan-design-system"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "novan-design-system:build:production"
        },
        "development": {
          "buildTarget": "novan-design-system:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "test": {
      "executor": "@angular/build:unit-test"
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
      }
    },
    "storybook-browser-target": {
      "executor": "@angular-devkit/build-angular:browser",
      "defaultConfiguration": "development",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/storybook-browser-target",
        "index": "src/index.html",
        "main": "src/main.ts",
        "tsConfig": "tsconfig.storybook.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": [".storybook/storybook-components.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "novan-design-system:storybook-browser-target",
        "configDir": ".storybook",
        "tsConfig": "tsconfig.storybook.json",
        "compodoc": false,
        "port": 6006
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "browserTarget": "novan-design-system:storybook-browser-target",
        "configDir": ".storybook",
        "tsConfig": "tsconfig.storybook.json",
        "compodoc": false,
        "outputDir": "storybook-static"
      }
    }
  }
}
